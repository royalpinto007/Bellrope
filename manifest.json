{
  "manifest_version": 3,
  "name": "Bellrope: Watch Pages for Changes",
  "version": "1.0.0",
  "description": "Watch one part of any page and get a notification when it changes. Checks run in your browser, not on someone's server.",
  "permissions": ["alarms", "notifications", "offscreen", "scripting", "sidePanel", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": {
    "default_title": "Bellrope",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "watch-page": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Watch something on this page"
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
